# ============================================================
# Application
# ============================================================
APP_NAME=suzihouse-backend
# IMPORTANT: Set to "production" in production and DEBUG=false
APP_ENV=development
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters in production
SECRET_KEY=<CHANGE-ME>

# ============================================================
# Database (MySQL)
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=suzihouse
DB_USER=suzihouse
DB_PASSWORD=<your-db-password>

# ============================================================
# Redis
# ============================================================
# Local dev (no auth):
REDIS_URL=redis://localhost:6379/0
# Production (with auth): redis://:your-redis-password@redis:6379/0

# ============================================================
# JWT
# ============================================================
# Generate SEPARATE secrets for each (MUST be different from each other):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<CHANGE-ME>
JWT_REFRESH_SECRET_KEY=<CHANGE-ME>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================
# CORS (Production MUST set explicit origins)
# ============================================================
# CORS_ORIGINS=["https://app.suzihouse.com"]

# ============================================================
# Rate Limiting (requests per minute)
# ============================================================
RATE_LIMIT_ANON=100
RATE_LIMIT_AUTH=300

# ============================================================
# Redis Password (required for docker-compose)
# ============================================================
# REDIS_PASSWORD=<generate-strong-password>

# ============================================================
# CODEF API (공공데이터 연동)
# ============================================================
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
CODEF_BASE_URL=https://development.codef.io

# ============================================================
# MOLIT API (국토교통부 실거래가)
# ============================================================
MOLIT_API_KEY=
MOLIT_BASE_URL=https://apis.data.go.kr

# ============================================================
# OpenAI
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ============================================================
# Celery
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
